+  async suspendWorkspace({
+    workspaceId,
+    actorUserId,
+  }: {
+    workspaceId: string;
+    actorUserId: string;
+  }): Promise<boolean> {
+    const workspace = await this.workspaceRepository.findOne({
+      where: { id: workspaceId },
+      withDeleted: true,
+    });
+
+    if (!isDefined(workspace) || isDefined(workspace.deletedAt)) {
+      throw new BillingException(
+        `Workspace ${workspaceId} not found`,
+        BillingExceptionCode.BILLING_SUBSCRIPTION_EVENT_WORKSPACE_NOT_FOUND,
+      );
+    }
+
+    await this.workspaceService.suspendWorkspace(workspaceId);
+
+    if (this.twentyConfigService.get('IS_BILLING_ENABLED')) {
+      await this.billingSubscriptionService.cancelSubscription(workspaceId);
+
+      const creditGrants = await this.getWorkspaceCreditGrants(workspaceId);
+      const activeCreditGrants = creditGrants.filter((grant) => grant.isActive);
+
+      for (const grant of activeCreditGrants) {
+        await this.billingCreditService.revokeGrant({
+          workspaceId,
+          grantId: grant.id,
+          revokedByUserId: actorUserId,
+        });
+      }
+    }
+
+    const emailingDomains =
+      await this.emailingDomainService.getEmailingDomains(workspace);
+
+    await this.deleteCascadeMessageQueueService.add<EmailingDomainWorkspaceCleanupJobData>(
+      EmailingDomainWorkspaceCleanupJob.name,
+      {
+        workspaceId,
+        domains: emailingDomains.map(
+          (emailingDomain) => emailingDomain.domain,
+        ),
+      },
+      {
+        workspaceId,
+        isWorkspaceJob: true,
+      },
+    );
+
+    return true;
+  }
