+      throw new BillingException(
+        `Workspace ${workspaceId} not found`,
+        BillingExceptionCode.BILLING_SUBSCRIPTION_EVENT_WORKSPACE_NOT_FOUND,
+      );
+    }
+
+    if (this.twentyConfigService.get('IS_BILLING_ENABLED')) {
+      await this.billingSubscriptionService.cancelSubscription(workspaceId);
+
+      const creditGrants = await this.getWorkspaceCreditGrants(workspaceId);
+      const activeCreditGrants = creditGrants.filter((grant) => grant.isActive);
+
+      for (const grant of activeCreditGrants) {
+        await this.billingCreditService.revokeGrant({
+          workspaceId,
+          grantId: grant.id,
+          revokedByUserId: actorUserId,
+        });
+      }
+    }
+
+    await this.workspaceService.suspendWorkspace(workspaceId);
+
+    const emailingDomains =
