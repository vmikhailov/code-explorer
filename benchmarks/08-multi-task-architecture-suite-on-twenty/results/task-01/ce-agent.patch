+++ b/packages/twenty-server/src/engine/core-modules/two-factor-authentication/two-factor-authentication.service.ts
@@ -385,4 +385,30 @@ export class TwoFactorAuthenticationService {
 
     return { success: true };
   }
+
+  async resetTwoFactorAuthenticationMethodsForUser({
+    userId,
+    workspaceId,
+  }: {
+    userId: UserEntity['id'];
+    workspaceId: WorkspaceEntity['id'];
+  }) {
+    const userWorkspace =
+      await this.userWorkspaceService.getUserWorkspaceForUserOrThrow({
+        userId,
+        workspaceId,
+      });
+
+    await this.twoFactorAuthenticationMethodRepository.delete(workspaceId, {
+      userWorkspaceId: userWorkspace.id,
+    });
+
+    await this.revokeRecoveryCodes({
+      workspaceId,
+      userId,
+      includeRedeemed: true,
+    });
+
+    return { success: true };
+  }
 }
