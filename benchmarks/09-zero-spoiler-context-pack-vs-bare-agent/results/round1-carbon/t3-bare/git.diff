--- /dev/null
+++ b/packages/twenty-server/src/engine/core-modules/public-domain/public-domain-lookup/public-domain-lookup.service.ts
@@ -0,0 +1,68 @@
+import { Injectable } from '@nestjs/common';
+import { InjectRepository } from '@nestjs/typeorm';
+
+import { isNonEmptyString } from '@sniptt/guards';
+import { Raw, Repository } from 'typeorm';
+
+import { PublicDomainEntity } from 'src/engine/core-modules/public-domain/public-domain.entity';
+
+@Injectable()
+export class PublicDomainLookupService {
+  constructor(
+    // Global public-domain hostname lookups run across workspaces (routing and subdomain collision checks).
+    // eslint-disable-next-line twenty/prefer-workspace-scoped-repository
+    @InjectRepository(PublicDomainEntity)
+    private readonly publicDomainRepository: Repository<PublicDomainEntity>,
+  ) {}
+
+  async findByDomain(domain: string): Promise<PublicDomainEntity | null> {
+    const normalizedDomain = domain.trim().toLowerCase();
+
+    if (!isNonEmptyString(normalizedDomain)) {
+      return null;
+    }
+
+    return this.publicDomainRepository.findOne({
+      where: {
+        domain: Raw(
+          (alias) => `LOWER(${this.quoteColumnAlias(alias)}) = :domain`,
+          { domain: normalizedDomain },
+        ),
+      },
+    });
+  }
+
+  async findByDomains(domains: string[]): Promise<PublicDomainEntity[]> {
+    const normalizedDomains = [
+      ...new Set(
+        domains
+          .map((domain) => domain.trim().toLowerCase())
+          .filter(isNonEmptyString),
+      ),
+    ];
+
+    if (normalizedDomains.length === 0) {
+      return [];
+    }
+
+    return this.publicDomainRepository.find({
+      where: {
+        domain: Raw(
+          (alias) => `LOWER(${this.quoteColumnAlias(alias)}) IN (:...domains)`,
+          { domains: normalizedDomains },
+        ),
+      },
+      select: {
+        id: true,
+        domain: true,
+      },
+    });
+  }
+
+  private quoteColumnAlias(alias: string): string {
+    return alias
+      .split('.')
+      .map((aliasPart) => `"${aliasPart.replace(/"/g, '')}"`)
+      .join('.');
+  }
+}
