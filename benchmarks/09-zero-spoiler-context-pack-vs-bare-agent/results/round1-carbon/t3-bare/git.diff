diff --git a/packages/twenty-server/src/engine/core-modules/public-domain/public-domain-lookup/public-domain-lookup.service.ts b/packages/twenty-server/src/engine/core-modules/public-domain/public-domain-lookup/public-domain-lookup.service.ts
