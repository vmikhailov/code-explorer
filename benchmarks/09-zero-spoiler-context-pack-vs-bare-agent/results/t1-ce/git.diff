+id: SIG-TWENTY-004
+category: Architectural
+platform: agnostic
+scope: Module
+dimension: Boundaries
+name: "Core-to-Feature Layer Isolation"
+severity: Error
+description: "Core engine modules (src/engine/core-modules/**) must not introduce new direct calls to workspace feature modules (src/modules/**). Cross-layer side effects must be decoupled via domain events or message queues."
+remediation: "Decouple side effects from src/engine/core-modules/** via WorkspaceEventBatch / EventEmitter2 or MessageQueueService instead of calling src/modules/** directly."
+target: "{target.name}"
+message: "Core module function '{caller.name}' directly calls feature module function '{target.name}' at {location}"
+thresholds:
+  warning: 1
+  error: 1
+ratchet:
+  enabled: true
+  baseline: baselines/SIG-TWENTY-004.json
+query: |
+  MATCH (caller:Function)-[r:CALLS]->(target:Function)
+  WHERE caller.path STARTS WITH 'packages/twenty-server/src/engine/core-modules/'
+    AND target.path STARTS WITH 'packages/twenty-server/src/modules/'
+    AND NOT coalesce(caller.is_test, false)
+  RETURN caller, r, target
