@@ -0,0 +1,30 @@
+id: SIG-TWENTY-003
+category: Architectural
+platform: agnostic
+scope: Module
+dimension: Boundaries
+name: "Core Domain & Application Sub-Domain Table Ownership"
+severity: Error
+description: "Core modules (src/engine/core-modules/<domain>/**) and application sub-domains (src/engine/core-modules/application/<sub-domain>/**) must not introduce new direct database reads or writes (READS_FROM|WRITES_TO) against tables whose owning TypeORM Entity belongs to another domain or sub-domain. Cross-domain state must be accessed or mutated exclusively through the owning module's exported service."
+remediation: "Do not inject another module's TypeORM Entity repository or query its table directly; import the owning NestJS module and call its exported domain service."
+target: "{t.name}"
+message: "Function '{fn.name}' in '{fn.path}' directly accesses table '{t.name}' owned by '{e.name}' in '{e.path}'"
+thresholds:
+  warning: 1
+  error: 1
+ratchet:
+  enabled: true
+  baseline: baselines/SIG-TWENTY-003.json
+query: |
+  MATCH (fn:Function)-[r:READS_FROM|WRITES_TO]->(t:Table)-[:IMPLEMENTED_BY]->(e:Type)
+  WHERE fn.path STARTS WITH 'packages/twenty-server/src/engine/core-modules/'
+    AND e.path STARTS WITH 'packages/twenty-server/src/engine/core-modules/'
+    AND NOT coalesce(fn.is_test, false)
+    AND (
+      split(fn.path, '/')[5] <> split(e.path, '/')[5]
+      OR (
+        split(fn.path, '/')[5] = 'application'
+        AND split(fn.path, '/')[6] <> split(e.path, '/')[6]
+      )
+    )
+  RETURN fn, r, t
