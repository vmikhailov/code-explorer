@@ -0,0 +1,24 @@
+id: SIG-TWENTY-006
+category: Architectural
+platform: agnostic
+scope: Method
+dimension: Resources
+name: "Transport Handler Thinness Ceiling (<= 45 LOC)"
+severity: Error
+description: "GraphQL Resolver (*.resolver.ts) and HTTP Controller (*.controller.ts) methods in twenty-server core-modules must remain thin transport adapters (<= 45 LOC) and delegate orchestration, validation, and domain logic to services."
+remediation: "Extract business, validation, and orchestration logic out of the resolver/controller method into a domain service so the transport method stays <= 45 LOC."
+thresholds:
+  warning: 1
+  error: 1
+ratchet:
+  enabled: true
+  baseline: baselines/SIG-TWENTY-006.json
+query: |
+  MATCH (fn:Function)
+  WHERE fn.path STARTS WITH 'packages/twenty-server/src/engine/core-modules/'
+    AND (fn.path ENDS WITH '.resolver.ts' OR fn.path ENDS WITH '.controller.ts')
+    AND fn.name <> '<module_init>'
+    AND fn.name <> 'constructor'
+    AND NOT coalesce(fn.is_test, false)
+    AND coalesce(fn.loc, 0) > 45
+  RETURN fn.path AS file, fn.start_line AS line, fn.name AS symbol, 'max_45_loc' AS target, 'Transport handler ' + fn.name + ' is ' + toString(fn.loc) + ' LOC (max 45 LOC); delegate business logic to a domain service' AS message
