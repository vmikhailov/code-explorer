@@ -0,0 +1,23 @@
+id: SIG-TWENTY-007
+category: Architectural
+platform: agnostic
+scope: Method
+dimension: Rules
+name: "No Silent Exception Swallowing"
+severity: Error
+description: "Production TypeScript code in twenty-server must not contain empty catch blocks without an explicit explanatory comment or error handling."
+remediation: "Handle, rethrow, or log the caught error, or document why the exception is intentionally ignored."
+thresholds:
+  warning: 1
+  error: 1
+ratchet:
+  enabled: true
+  baseline: baselines/SIG-TWENTY-007.json
+query: |
+  MATCH (c:CatchClause)
+  WHERE c.file_path STARTS WITH 'packages/twenty-server/src/'
+    AND NOT c.file_path ENDS WITH '.spec.ts'
+    AND NOT coalesce(c.is_test, false)
+    AND c.is_empty = true
+    AND coalesce(c.has_comment, false) = false
+  RETURN c.file_path AS file, coalesce(c.line, 1) AS line, coalesce(c.exception_type, 'catch') AS symbol, 'catch' AS target, 'Empty catch block swallows exceptions without handling or explanatory comment' AS message
