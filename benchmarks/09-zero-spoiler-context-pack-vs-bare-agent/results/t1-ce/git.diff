+id: SIG-TWENTY-005
+category: Architectural
+platform: agnostic
+scope: Method
+dimension: Boundaries
+name: "Async Queue Worker Boundary (No Direct Job .handle() Invocation)"
+severity: Error
+description: "Production code (packages/twenty-server/src/**) must never invoke @Processor background job .handle() methods directly. Background jobs in /jobs/ must be enqueued asynchronously via MessageQueueService.add()."
+remediation: "Inject MessageQueueService via @InjectMessageQueue(MessageQueue.<queue>) and call .add<JobData>(JobClass.name, payload) instead of calling job.handle() synchronously."
+target: "{job.name}.handle"
+message: "Function '{caller.name}' directly calls background job '{job.name}.handle()' at {location}"
+thresholds:
+  warning: 1
+  error: 1
+ratchet:
+  enabled: true
+  baseline: baselines/SIG-TWENTY-005.json
+query: |
+  MATCH (caller:Function)-[r:CALLS]->(h:Function {name: 'handle'})<-[:HAS_METHOD]-(job:Type)
+  WHERE caller.path STARTS WITH 'packages/twenty-server/src/'
+    AND NOT caller.path ENDS WITH '.spec.ts'
+    AND job.path CONTAINS '/jobs/'
+  RETURN caller, r, h
