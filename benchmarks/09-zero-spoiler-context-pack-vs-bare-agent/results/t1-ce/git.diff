+id: SIG-TWENTY-002
+category: Architectural
+platform: agnostic
+scope: Module
+dimension: Boundaries
+name: "Metadata Table Ownership"
+severity: Error
+description: "Core engine modules (src/engine/core-modules/**) must not directly read or write database tables owned by metadata modules (src/engine/metadata-modules/**). Metadata state must be accessed through exported metadata services."
+remediation: "Import the owning metadata module and call its exported service instead of querying metadata TypeORM entities directly from core-modules."
+target: "{t.name}"
+message: "Core function '{fn.name}' directly accesses metadata table '{t.name}' ({type(r)}) owned by '{e.name}'"
+thresholds:
+  warning: 1
+  error: 1
+ratchet:
+  enabled: true
+  baseline: baselines/SIG-TWENTY-002.json
+query: |
+  MATCH (fn:Function)-[r:READS_FROM|WRITES_TO]->(t:Table)-[:IMPLEMENTED_BY]->(e:Type)
+  WHERE fn.path STARTS WITH 'packages/twenty-server/src/engine/core-modules/'
+    AND e.path STARTS WITH 'packages/twenty-server/src/engine/metadata-modules/'
+    AND NOT coalesce(fn.is_test, false)
+  RETURN fn, r, t
diff --git a/.codeexplorer/gates/architectural/sig-twenty-003-core-domain-table-ownership.yaml b/.codeexplorer/gates/architectural/sig-twenty-003-core-domain-table-ownership.yaml
