@@ -0,0 +1,23 @@
+id: SIG-TWENTY-001
+category: Architectural
+platform: agnostic
+scope: Class
+dimension: Boundaries
+name: "Transport State Purity (No Direct DB Access in Resolvers/Controllers)"
+severity: Error
+description: "GraphQL Resolvers (*.resolver.ts) and HTTP Controllers (*.controller.ts) in twenty-server core-modules must not directly read from or write to database tables (READS_FROM|WRITES_TO). All persistence queries and mutations must be delegated to domain services."
+remediation: "Remove @InjectRepository / Repository / DataSource usage from the resolver or controller and delegate the persistence operation to the owning domain service."
+target: "{t.name}"
+message: "Transport handler '{fn.name}' directly accesses table '{t.name}' ({type(r)}) at {location}"
+thresholds:
+  warning: 1
+  error: 1
+ratchet:
+  enabled: true
+  baseline: baselines/SIG-TWENTY-001.json
+query: |
+  MATCH (fn:Function)-[r:READS_FROM|WRITES_TO]->(t:Table)
+  WHERE fn.path STARTS WITH 'packages/twenty-server/src/engine/core-modules/'
+    AND (fn.path ENDS WITH '.resolver.ts' OR fn.path ENDS WITH '.controller.ts')
+    AND NOT coalesce(fn.is_test, false)
+  RETURN fn, r, t
