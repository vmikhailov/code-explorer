<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Vars are not defined when building projects explicitly -->
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>

    <!-- Output paths: All build artifacts from all projects go strictly under $(SolutionDir).Build\ -->
    <BaseIntermediateOutputPath>$(SolutionDir).Build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)_$(Platform)\</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <OutputPath>$(SolutionDir).Build\bin_$(Configuration)_$(Platform)\$(MSBuildProjectName)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <DocumentationFile>$(SolutionDir).Build\doc_$(Configuration)\$(MSBuildProjectName).xml</DocumentationFile>
    <PublishDir Condition="'$(PublishDir)' == '' and '$(RuntimeIdentifier)' != ''">$(SolutionDir).Build\publish_$(Configuration)_$(RuntimeIdentifier)\$(MSBuildProjectName)\</PublishDir>
    <PublishDir Condition="'$(PublishDir)' == '' and '$(RuntimeIdentifier)' == ''">$(SolutionDir).Build\publish_$(Configuration)\$(MSBuildProjectName)\</PublishDir>

    <!-- Versioning -->
    <Version Condition="'$(Version)' == ''">1.84.0</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Version)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- NuGet packages generation -->
    <Authors Condition="'$(Authors)' == ''">Slava Mikhailov</Authors>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/vmikhailov/code-explorer</RepositoryUrl>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://code-explorer.mikhailov.cc</PackageProjectUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <Description Condition="'$(Description)' == ''">CodeExplorer SDK library ($(MSBuildProjectName)) — polyglot AST, code ontology graph, and OpenCypher engine.</Description>
    <PackageOutputPath>$(SolutionDir).Packages</PackageOutputPath>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == '' and Exists('$(MSBuildProjectDirectory)\README.md')">README.md</PackageReadmeFile>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <NoWarn Condition="'$(PublishTrimmed)' == 'true'">$(NoWarn);IL2026;IL2070;IL2072;IL2075;IL2076;IL2090;IL2091;IL2104</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/SampleProjects/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'CodeExplorer.Cypher' and '$(MSBuildProjectName)' != 'CodeExplorer.Cypher.Tests' and '$(MSBuildProjectName)' != 'OntologyGen' and !$(MSBuildProjectName.Contains('Sample'))">
    <Using Include="CodeExplorer.Common" />
    <Using Include="CodeExplorer.Core.Common" />
    <Using Include="CodeExplorer.Core.Parser" />
    <Using Include="CodeExplorer.Core.Analysis" />
    <Using Include="CodeExplorer.Cypher.Common" />
    <Using Include="CodeExplorer.Cypher.Linq" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
