<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
        <PackageVersion Include="CommandLineParser" Version="2.9.1" />
        <PackageVersion Include="Dapper" Version="2.1.100" />
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageVersion Include="LLamaSharp" Version="0.30.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
        <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
        <PackageVersion Include="NUnit" Version="5.0.0" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageVersion Include="Superpower" Version="3.2.1" />
        <PackageVersion Include="Tomlyn" Version="2.11.1" />
        <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>
</Project>
