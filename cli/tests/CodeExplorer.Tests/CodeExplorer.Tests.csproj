<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="CodeExplorer.Core.Database" />
    <Using Include="CodeExplorer.Core.Mcp" />
    <Using Include="CodeExplorer.Core.Gates" />
    <Using Include="CodeExplorer.Server" />
    <Using Include="CodeExplorer.Core.Common.ProjectRole" Alias="ProjectRole" />
    <Using Include="CodeExplorer.Core.Analysis.ArchitectureViewType" Alias="ArchitectureViewType" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\CodeExplorer.Core\CodeExplorer.Core.csproj" />
    <ProjectReference Include="..\..\src\Core\CodeExplorer.Storage\CodeExplorer.Storage.csproj" />
    <ProjectReference Include="..\..\src\Core\CodeExplorer.Gates\CodeExplorer.Gates.csproj" />
    <ProjectReference Include="..\..\src\Core\CodeExplorer.Indexing\CodeExplorer.Indexing.csproj" />
    <ProjectReference Include="..\..\src\Core\CodeExplorer.Intent\CodeExplorer.Intent.csproj" />
    <ProjectReference Include="..\..\src\Core\CodeExplorer.Analysis\CodeExplorer.Analysis.csproj" />

    <ProjectReference Include="..\..\src\Server\CodeExplorer.Server\CodeExplorer.Server.csproj" />

    <ProjectReference Include="..\..\src\UI\CodeExplorer\CodeExplorer.csproj" />
    <ProjectReference Include="..\..\src\TreeSitter\CodeExplorer.TreeSitter\CodeExplorer.TreeSitter.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Kotlin\CodeExplorer.Parsers.Kotlin.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Perl\CodeExplorer.Parsers.Perl.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Php\CodeExplorer.Parsers.Php.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Java\CodeExplorer.Parsers.Java.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Android\CodeExplorer.Parsers.Android.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Rust\CodeExplorer.Parsers.Rust.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Shared\CodeExplorer.Parsers.Shared.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Script\CodeExplorer.Parsers.Script.csproj" />
    <ProjectReference Include="..\..\src\Parsers\CodeExplorer.Parsers.Terraform\CodeExplorer.Parsers.Terraform.csproj" />
  </ItemGroup>

  <!-- Link OntologyGen source files so tests can use the extractor/renderer directly -->
  <ItemGroup>
    <Compile Include="..\..\src\Tools\CodeExplorer.OntologyGen\Models.cs" Link="OntologyGen\Models.cs" />
    <Compile Include="..\..\src\Tools\CodeExplorer.OntologyGen\OntologyExtractor.cs" Link="OntologyGen\OntologyExtractor.cs" />
    <Compile Include="..\..\src\Tools\CodeExplorer.OntologyGen\MarkdownRenderer.cs" Link="OntologyGen\MarkdownRenderer.cs" />
    <Compile Include="..\..\src\Tools\CodeExplorer.OntologyGen\JsonSchemaRenderer.cs" Link="OntologyGen\JsonSchemaRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
