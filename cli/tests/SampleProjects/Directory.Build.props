<Project>
  <!-- Isolate sample test projects from MSBuild compilation, restore, and analyzer pipelines -->
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <SkipCompilerExecution>true</SkipCompilerExecution>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Route any IDE/tool design-time inspection outputs to .Build\ as well -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), CodeExplorer.slnx))\</SolutionDir>
    <BaseIntermediateOutputPath>$(SolutionDir).Build\obj\SampleProjects\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)_$(Platform)\</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <OutputPath>$(SolutionDir).Build\bin_SampleProjects\$(MSBuildProjectName)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
  </PropertyGroup>

  <!-- Override standard build targets to no-ops -->
  <Target Name="Build" />
  <Target Name="Compile" />
  <Target Name="CoreCompile" />
  <Target Name="Restore" />
  <Target Name="Publish" />
</Project>
