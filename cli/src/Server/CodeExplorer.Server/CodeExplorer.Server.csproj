<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(CeTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodeExplorer.Server</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="CodeExplorer" />
    <InternalsVisibleTo Include="CodeExplorer.Tests" />
    <Using Include="CodeExplorer.Core.Database" />
    <Using Include="CodeExplorer.Core.Mcp" />
    <Using Include="CodeExplorer.Core.Gates.Engine" />
    <Using Include="CodeExplorer.Core.Gates.Models" />
    <Using Include="CodeExplorer.Core.Gates.Storage" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CodeExplorer.Core\CodeExplorer.Core.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Storage\CodeExplorer.Storage.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Gates\CodeExplorer.Gates.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Indexing\CodeExplorer.Indexing.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Analysis\CodeExplorer.Analysis.csproj" />
  </ItemGroup>

</Project>
