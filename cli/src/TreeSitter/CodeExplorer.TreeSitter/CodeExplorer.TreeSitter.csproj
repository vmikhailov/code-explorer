<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(CeTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreeSitterNativeRuntimesDir>$(SolutionDir).Build\runtimes</TreeSitterNativeRuntimesDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' and Exists('$(TreeSitterNativeRuntimesDir)')">
    <Content Include="$(TreeSitterNativeRuntimesDir)\**\*.*"
             Exclude="$(TreeSitterNativeRuntimesDir)\.stamp"
             Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and Exists('$(TreeSitterNativeRuntimesDir)\$(RuntimeIdentifier)\native')">
    <None Include="$(TreeSitterNativeRuntimesDir)\$(RuntimeIdentifier)\native\*.*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
