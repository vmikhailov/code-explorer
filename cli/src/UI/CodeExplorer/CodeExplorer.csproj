<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CodeExplorer.Core\CodeExplorer.Core.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Android\CodeExplorer.Parser.Android.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.CSharp\CodeExplorer.Parser.CSharp.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Go\CodeExplorer.Parser.Go.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Java\CodeExplorer.Parser.Java.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Kotlin\CodeExplorer.Parser.Kotlin.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Python\CodeExplorer.Parser.Python.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Rust\CodeExplorer.Parser.Rust.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Shared\CodeExplorer.Parser.Shared.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.TypeScript\CodeExplorer.Parser.TypeScript.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.SQL\CodeExplorer.Parser.SQL.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.ColdFusion\CodeExplorer.Parser.ColdFusion.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parser.Script\CodeExplorer.Parser.Script.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ce</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Runtime compatibility -->
    <RollForward>Major</RollForward>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>

    <!-- Single-file self-contained publish settings -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- .NET Global Tool settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ce</ToolCommandName>
    <PackageId>CodeExplorer.Cli</PackageId>
    <Title>CodeExplorer CLI — Architecture Intelligence &amp; MCP Code Graph</Title>
    <Authors>Slava Mikhailov</Authors>
    <PackageDescription>Architecture Intelligence &amp; Embedded Code Graph Engine for AI coding agents (Claude Code, Cursor, Copilot) and engineering teams. CodeExplorer (ce) parses polyglot codebases (C#, TypeScript/JavaScript, Java, Kotlin, Python, Go, Rust, SQL, ColdFusion), compiles a fast local SQLite code graph, provides an OpenCypher query engine, serves a Model Context Protocol (MCP) server, and enforces architectural guardrails with Semantic Invariant Gates (SIG).</PackageDescription>
    <Description>Architecture Intelligence &amp; Embedded Code Graph Engine for AI coding agents (Claude Code, Cursor, Copilot) and engineering teams. CodeExplorer (ce) parses polyglot codebases (C#, TypeScript/JavaScript, Java, Kotlin, Python, Go, Rust, SQL, ColdFusion), compiles a fast local SQLite code graph, provides an OpenCypher query engine, serves a Model Context Protocol (MCP) server, and enforces architectural guardrails with Semantic Invariant Gates (SIG).</Description>
    <PackageTags>mcp;mcp-server;ai-agents;claude-code;cursor;copilot;architecture;static-analysis;code-graph;opencypher;cypher;sqlite;ast;tree-sitter;csharp;dotnet;roslyn;typescript;dependency-graph;cli;tools;gates</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vmikhailov/code-explorer</RepositoryUrl>
    <PackageProjectUrl>https://code-explorer.mikhailov.cc</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/vmikhailov/code-explorer/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\vscode-extension\media\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>


</Project>
