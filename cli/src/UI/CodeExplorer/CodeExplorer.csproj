<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>

  </ItemGroup>

  <ItemGroup>
    <Using Include="CodeExplorer.Core.Database" />
    <Using Include="CodeExplorer.Core.Mcp" />
    <Using Include="CodeExplorer.Core.Gates" />
    <Using Include="CodeExplorer.Server" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Core\CodeExplorer.Core.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Storage\CodeExplorer.Storage.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Gates\CodeExplorer.Gates.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Indexing\CodeExplorer.Indexing.csproj" />
    <ProjectReference Include="..\..\Core\CodeExplorer.Analysis\CodeExplorer.Analysis.csproj" />
    <ProjectReference Include="..\..\Server\CodeExplorer.Server\CodeExplorer.Server.csproj" />

    <ProjectReference Include="..\..\TreeSitter\CodeExplorer.TreeSitter\CodeExplorer.TreeSitter.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Android\CodeExplorer.Parsers.Android.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.CSharp\CodeExplorer.Parsers.CSharp.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Go\CodeExplorer.Parsers.Go.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Java\CodeExplorer.Parsers.Java.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Kotlin\CodeExplorer.Parsers.Kotlin.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Python\CodeExplorer.Parsers.Python.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Rust\CodeExplorer.Parsers.Rust.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Shared\CodeExplorer.Parsers.Shared.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.TypeScript\CodeExplorer.Parsers.TypeScript.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Sql\CodeExplorer.Parsers.Sql.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Terraform\CodeExplorer.Parsers.Terraform.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.ColdFusion\CodeExplorer.Parsers.ColdFusion.csproj" />
    <ProjectReference Include="..\..\Parsers\CodeExplorer.Parsers.Script\CodeExplorer.Parsers.Script.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ce</AssemblyName>
    <TargetFrameworks>$(CeTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <!-- Runtime compatibility -->
    <RollForward>Major</RollForward>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</RuntimeFrameworkVersion>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.0</RuntimeFrameworkVersion>

    <!-- Single-file self-contained publish settings -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <PropertyGroup>

    <!-- .NET Global Tool settings -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ce</ToolCommandName>
    <PackageId>CodeExplorer.Cli</PackageId>
    <Title>CodeExplorer CLI — Architecture Intelligence &amp; MCP Code Graph</Title>
    <Authors>Slava Mikhailov</Authors>
    <PackageDescription>Architecture Intelligence &amp; Embedded Code Graph Engine for AI coding agents (Claude Code, Cursor, Copilot) and engineering teams. CodeExplorer (ce) parses polyglot codebases (C#, TypeScript/JavaScript, Java, Kotlin, Python, Go, Rust, SQL, ColdFusion), compiles a fast local SQLite code graph, provides an OpenCypher query engine, serves a Model Context Protocol (MCP) server, and enforces architectural guardrails with Semantic Invariant Gates (SIG).</PackageDescription>
    <Description>Architecture Intelligence &amp; Embedded Code Graph Engine for AI coding agents (Claude Code, Cursor, Copilot) and engineering teams. CodeExplorer (ce) parses polyglot codebases (C#, TypeScript/JavaScript, Java, Kotlin, Python, Go, Rust, SQL, ColdFusion), compiles a fast local SQLite code graph, provides an OpenCypher query engine, serves a Model Context Protocol (MCP) server, and enforces architectural guardrails with Semantic Invariant Gates (SIG).</Description>
    <PackageTags>mcp;mcp-server;ai-agents;claude-code;cursor;copilot;architecture;static-analysis;code-graph;opencypher;cypher;sqlite;ast;tree-sitter;csharp;dotnet;roslyn;typescript;dependency-graph;cli;tools;gates</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vmikhailov/code-explorer</RepositoryUrl>
    <PackageProjectUrl>https://code-explorer.mikhailov.cc</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/vmikhailov/code-explorer/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\vscode-extension\media\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>


</Project>
