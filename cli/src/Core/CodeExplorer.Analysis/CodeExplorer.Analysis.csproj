<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodeExplorer.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeExplorer.Server" />
    <InternalsVisibleTo Include="CodeExplorer" />
    <InternalsVisibleTo Include="CodeExplorer.Tests" />
    <Using Include="CodeExplorer.Core.Database" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeExplorer.Core\CodeExplorer.Core.csproj" />
    <ProjectReference Include="..\CodeExplorer.Gates\CodeExplorer.Gates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.cypher" />
    <EmbeddedResource Include="Resources\**\*.json" />
  </ItemGroup>

</Project>
