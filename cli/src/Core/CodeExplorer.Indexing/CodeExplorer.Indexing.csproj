<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(CeTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CodeExplorer.Core</RootNamespace>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyParserAssembliesToPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CodeExplorer.Analysis" />
        <InternalsVisibleTo Include="CodeExplorer.Server" />
        <InternalsVisibleTo Include="CodeExplorer" />
        <InternalsVisibleTo Include="CodeExplorer.Tests" />
        <Using Include="CodeExplorer.Core.Database" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Superpower" />
        <PackageReference Include="Tomlyn" />
        <PackageReference Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Cypher\CodeExplorer.Cypher\CodeExplorer.Cypher.csproj" />
        <ProjectReference
            Include="..\CodeExplorer.Core\CodeExplorer.Core.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\TreeSitter\CodeExplorer.TreeSitter\CodeExplorer.TreeSitter.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Android\CodeExplorer.Parsers.Android.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.CSharp\CodeExplorer.Parsers.CSharp.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Go\CodeExplorer.Parsers.Go.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Java\CodeExplorer.Parsers.Java.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Kotlin\CodeExplorer.Parsers.Kotlin.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Perl\CodeExplorer.Parsers.Perl.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Php\CodeExplorer.Parsers.Php.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Python\CodeExplorer.Parsers.Python.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Rust\CodeExplorer.Parsers.Rust.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Shared\CodeExplorer.Parsers.Shared.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.TypeScript\CodeExplorer.Parsers.TypeScript.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Sql\CodeExplorer.Parsers.Sql.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Terraform\CodeExplorer.Parsers.Terraform.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.ColdFusion\CodeExplorer.Parsers.ColdFusion.csproj"
            PrivateAssets="all"
        />
        <ProjectReference
            Include="..\..\Parsers\CodeExplorer.Parsers.Script\CodeExplorer.Parsers.Script.csproj"
            PrivateAssets="all"
        />
    </ItemGroup>

    <Target Name="CopyParserAssembliesToPackage">
        <ItemGroup>
            <BuildOutputInPackage Include="$(OutputPath)CodeExplorer.Core.dll" />
            <BuildOutputInPackage Include="$(OutputPath)CodeExplorer.Parsers.*.dll" />
            <BuildOutputInPackage Include="$(OutputPath)CodeExplorer.TreeSitter.dll" />
        </ItemGroup>
    </Target>

    <ItemGroup Condition="Exists('$(SolutionDir).Build\runtimes')">
        <None
            Include="$(SolutionDir).Build\runtimes\**"
            Exclude="$(SolutionDir).Build\runtimes\.stamp;$(SolutionDir).Build\runtimes\**\.*"
            Pack="true"
            PackagePath="runtimes"
            Visible="false"
        />
    </ItemGroup>
</Project>
