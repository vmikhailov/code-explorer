<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeExplorer.Storage" />
    <InternalsVisibleTo Include="CodeExplorer.Gates" />
    <InternalsVisibleTo Include="CodeExplorer.Indexing" />
    <InternalsVisibleTo Include="CodeExplorer.Analysis" />
    <InternalsVisibleTo Include="CodeExplorer.Server" />
    <InternalsVisibleTo Include="CodeExplorer" />
    <InternalsVisibleTo Include="CodeExplorer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.2" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.18.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cypher\CodeExplorer.Cypher\CodeExplorer.Cypher.csproj" />
  </ItemGroup>

  <Target Name="GenerateOntologyDocs" AfterTargets="Build">
    <Exec Command="dotnet run --project &quot;$(SolutionDir)src/Tools/CodeExplorer.OntologyGen/OntologyGen.csproj&quot; -- &quot;$(MSBuildThisFileDirectory)Common&quot; &quot;$(SolutionDir)../docs/ontology.md&quot; &quot;$(SolutionDir)../proto/ontology-schema.json&quot;" />
    <Exec Command="node &quot;$(SolutionDir)../scripts/sync-ontology-site.mjs&quot;" />
  </Target>

</Project>
