<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.18.1" />
    <PackageReference Include="Neo4j.Driver" Version="6.1.2" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.cypher" />
    <EmbeddedResource Include="Resources\**\*.json" />
  </ItemGroup>

  <Target Name="GenerateOntologyDocs" AfterTargets="Build">
    <Exec Command="dotnet run --project &quot;$(SolutionDir)Tools/CodeExplorer.OntologyGen/OntologyGen.csproj&quot; -- &quot;$(MSBuildThisFileDirectory)Common&quot; &quot;$(SolutionDir)docs/ontology.md&quot;" />
  </Target>

</Project>
