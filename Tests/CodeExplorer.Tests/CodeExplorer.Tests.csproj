<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UI\CodeExplorer\CodeExplorer.csproj" />
  </ItemGroup>

  <!-- Link OntologyGen source files so tests can use the extractor/renderer directly -->
  <ItemGroup>
    <Compile Include="..\..\Tools\CodeExplorer.OntologyGen\Models.cs" Link="OntologyGen\Models.cs" />
    <Compile Include="..\..\Tools\CodeExplorer.OntologyGen\OntologyExtractor.cs"
      Link="OntologyGen\OntologyExtractor.cs" />
    <Compile Include="..\..\Tools\CodeExplorer.OntologyGen\MarkdownRenderer.cs"
      Link="OntologyGen\MarkdownRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>