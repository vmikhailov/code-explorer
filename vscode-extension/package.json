{
  "name": "code-explorer-vscode",
  "displayName": "CodeExplorer",
  "description": "Make AI coding agents production-safe. Live cross-service map of APIs, queues & databases in VS Code, surgical MCP context (Claude Code, Cursor, Copilot), and CI architecture gates.",
  "version": "1.65.5",
  "publisher": "vmikhailov",
  "license": "MIT",
  "icon": "media/icon_512_quant.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vmikhailov/code-explorer"
  },
  "homepage": "https://code-explorer.app",
  "bugs": {
    "url": "https://github.com/vmikhailov/code-explorer/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "claude-code",
    "cursor",
    "copilot",
    "windsurf",
    "architecture",
    "semantic-invariant-gates",
    "architecture-gates",
    "static-analysis",
    "code-graph",
    "opencypher",
    "cypher",
    "dependency-graph",
    "data-lineage",
    "blast-radius",
    "microservices",
    "linter",
    "csharp",
    "dotnet",
    "roslyn",
    "typescript",
    "java",
    "kotlin",
    "python",
    "golang",
    "sql",
    "sqlite",
    "ast"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Linters",
    "Visualization",
    "Programming Languages",
    "Testing"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:codeExplorerView",
    "onView:codeExplorerInspectorView",
    "workspaceContains:.codeexplorer/graph.db",
    "onWebviewPanel:codeExplorerGraph.semantic",
    "onWebviewPanel:codeExplorerGraph.contexts",
    "onWebviewPanel:codeExplorerGraph.layers",
    "onWebviewPanel:codeExplorerGraph.c1",
    "onWebviewPanel:codeExplorerGraph.flow",
    "onWebviewPanel:codeExplorerGraph.full",
    "onWebviewPanel:codeExplorerGraph.grid",
    "onWebviewPanel:codeExplorerGraph.mermaid",
    "onWebviewPanel:codeExplorerGraph.settings",
    "onWebviewPanel:codeExplorerGraph.gate-editor",
    "onCommand:codeExplorer.showGraph",
    "onCommand:codeExplorer.focusInspector",
    "onCommand:codeExplorer.reindex",
    "onCommand:codeExplorer.reindexFull",
    "onCommand:codeExplorer.initAndScan",
    "onCommand:codeExplorer.openWorkspaceSettings",
    "onCommand:codeExplorer.excludeFromScan"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-explorer-sidebar",
          "title": "CodeExplorer",
          "icon": "media/icon-sidebar.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "code-explorer-inspector",
          "title": "CodeExplorer Inspector",
          "icon": "media/icon-inspector.svg"
        }
      ]
    },
    "views": {
      "code-explorer-sidebar": [
        {
          "id": "codeExplorerView",
          "name": "CodeExplorer Graph",
          "type": "tree",
          "when": "workspaceFolderCount != 0"
        }
      ],
      "code-explorer-inspector": [
        {
          "id": "codeExplorerInspectorView",
          "name": "Graph Inspector & Controls",
          "type": "webview",
          "when": "workspaceFolderCount != 0"
        }
      ]
    },
    "commands": [
      {
        "command": "codeExplorer.initAndScan",
        "title": "CodeExplorer: Initialize & Scan Workspace",
        "icon": "$(rocket)"
      },
      {
        "command": "codeExplorer.showGraph",
        "title": "CodeExplorer: Show Architecture Graph",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "codeExplorer.focusInspector",
        "title": "CodeExplorer: Focus Graph Inspector & Controls",
        "icon": "$(sliders)"
      },
      {
        "command": "codeExplorer.reindex",
        "title": "CodeExplorer: Rescan Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "codeExplorer.reindexFull",
        "title": "CodeExplorer: Full Re-index (Clear & Rescan)",
        "icon": "$(clear-all)"
      },
      {
        "command": "codeExplorer.refreshTree",
        "title": "CodeExplorer: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "codeExplorer.restartServer",
        "title": "CodeExplorer: Restart Graph Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codeExplorer.openView",
        "title": "CodeExplorer: Open View",
        "icon": "$(play)"
      },
      {
        "command": "codeExplorer.focusNode",
        "title": "CodeExplorer: Focus Node in Graph",
        "icon": "$(eye)"
      },
      {
        "command": "codeExplorer.openSource",
        "title": "CodeExplorer: Go to Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codeExplorer.openNodeGrid",
        "title": "CodeExplorer: Open Node Grid",
        "icon": "$(table)"
      },
      {
        "command": "codeExplorer.distillIntents",
        "title": "CodeExplorer: Distill Architectural Intents (AI)",
        "icon": "$(sparkle)"
      },
      {
        "command": "codeExplorer.reindexIntentsFull",
        "title": "CodeExplorer: Full Re-distill Intents (Clear & Distill)",
        "icon": "$(clear-all)"
      },
      {
        "command": "codeExplorer.downloadModel",
        "title": "CodeExplorer: Download AI Intent Model",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeExplorer.modelStatus",
        "title": "CodeExplorer: AI Model Management & Status",
        "icon": "$(hubot)"
      },
      {
        "command": "codeExplorer.openSettings",
        "title": "CodeExplorer: Settings & AI Model Preferences",
        "icon": "$(gear)"
      },
      {
        "command": "codeExplorer.clearIntents",
        "title": "CodeExplorer: Clear AI Intent Cache",
        "icon": "$(trash)"
      },
      {
        "command": "codeExplorer.stopIntent",
        "title": "CodeExplorer: Stop Intent Distillation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codeExplorer.updateEngine",
        "title": "CodeExplorer: Check & Update Engine",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeExplorer.whatsNew",
        "title": "CodeExplorer: What's New",
        "icon": "$(megaphone)"
      },
      {
        "command": "codeExplorer.createGate",
        "title": "CodeExplorer: New Semantic Invariant Gate",
        "icon": "$(add)"
      },
      {
        "command": "codeExplorer.editGate",
        "title": "CodeExplorer: Edit Gate in Visual Editor",
        "icon": "$(edit)"
      },
      {
        "command": "codeExplorer.evaluateGates",
        "title": "CodeExplorer: Evaluate Semantic Invariant Gates",
        "icon": "$(shield)"
      },
      {
        "command": "codeExplorer.ratchetGates",
        "title": "CodeExplorer: Ratchet Gate Baseline",
        "icon": "$(check-all)"
      },
      {
        "command": "codeExplorer.initGates",
        "title": "CodeExplorer: Initialize Starter Gate (.yaml)",
        "icon": "$(add)"
      },
      {
        "command": "codeExplorer.openGateYaml",
        "title": "CodeExplorer: Edit Gate YAML Definition",
        "icon": "$(edit)"
      },
      {
        "command": "codeExplorer.openWorkspaceSettings",
        "title": "CodeExplorer: Open Workspace Settings (settings.json)",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codeExplorer.excludeFromScan",
        "title": "CodeExplorer: Exclude from Scan",
        "icon": "$(circle-slash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeExplorer.refreshTree",
          "when": "view == codeExplorerView",
          "group": "navigation@1"
        },
        {
          "command": "codeExplorer.showGraph",
          "when": "view == codeExplorerView",
          "group": "navigation@2"
        },
        {
          "command": "codeExplorer.focusInspector",
          "when": "view == codeExplorerView",
          "group": "navigation@2.5"
        },
        {
          "command": "codeExplorer.reindex",
          "when": "view == codeExplorerView",
          "group": "navigation@3"
        },
        {
          "command": "codeExplorer.distillIntents",
          "when": "view == codeExplorerView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "codeExplorer.createGate",
          "when": "viewItem == root-gates",
          "group": "inline@0"
        },
        {
          "command": "codeExplorer.evaluateGates",
          "when": "viewItem == root-gates || viewItem == gate-item",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.editGate",
          "when": "viewItem == gate-item",
          "group": "inline@2"
        },
        {
          "command": "codeExplorer.ratchetGates",
          "when": "viewItem == root-gates || viewItem == gate-item",
          "group": "inline@3"
        },
        {
          "command": "codeExplorer.openGateYaml",
          "when": "viewItem == gate-item",
          "group": "inline@4"
        },
        {
          "command": "codeExplorer.initGates",
          "when": "viewItem == root-gates",
          "group": "inline@4"
        },
        {
          "command": "codeExplorer.refreshTree",
          "when": "viewItem == root-management",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.restartServer",
          "when": "viewItem == management-server",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.updateEngine",
          "when": "viewItem == management-server",
          "group": "inline@2"
        },
        {
          "command": "codeExplorer.reindex",
          "when": "viewItem == management-graph",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.reindexFull",
          "when": "viewItem == management-graph",
          "group": "inline@2"
        },
        {
          "command": "codeExplorer.distillIntents",
          "when": "viewItem == management-intent",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.reindexIntentsFull",
          "when": "viewItem == management-intent",
          "group": "inline@2"
        },
        {
          "command": "codeExplorer.openWorkspaceSettings",
          "when": "viewItem == management-settings",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.openNodeGrid",
          "when": "viewItem == ontology-service",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.showGraph",
          "when": "viewItem == root-domains || viewItem == domain-item || viewItem == bounded-context-item",
          "group": "inline@1"
        },
        {
          "command": "codeExplorer.focusNode",
          "when": "viewItem == ontology-service",
          "group": "inline@2"
        },
        {
          "command": "codeExplorer.openView",
          "when": "viewItem == diagram-item || viewItem == layer-group",
          "group": "1_open@1"
        },
        {
          "command": "codeExplorer.openNodeGrid",
          "when": "viewItem == ontology-service || viewItem == services-category || viewItem == node-category || viewItem == rel-category || viewItem == service-group",
          "group": "1_open@2"
        },
        {
          "command": "codeExplorer.showGraph",
          "when": "viewItem == root-domains || viewItem == domain-item || viewItem == bounded-context-item || viewItem == ontology-service || viewItem == management-graph",
          "group": "1_open@3"
        },
        {
          "command": "codeExplorer.focusNode",
          "when": "viewItem == ontology-service || viewItem == node || viewItem == node-with-source",
          "group": "1_open@4"
        },
        {
          "command": "codeExplorer.openSource",
          "when": "viewItem == ontology-service || viewItem == service-item || viewItem == node-with-source || viewItem == gate-violation-item",
          "group": "1_open@5"
        },
        {
          "command": "codeExplorer.evaluateGates",
          "when": "viewItem == root-gates || viewItem == gate-item",
          "group": "2_actions@1"
        },
        {
          "command": "codeExplorer.ratchetGates",
          "when": "viewItem == root-gates || viewItem == gate-item",
          "group": "2_actions@2"
        },
        {
          "command": "codeExplorer.openGateYaml",
          "when": "viewItem == gate-item",
          "group": "2_actions@3"
        },
        {
          "command": "codeExplorer.initGates",
          "when": "viewItem == root-gates",
          "group": "2_actions@3"
        },
        {
          "command": "codeExplorer.reindex",
          "when": "viewItem == root-management || viewItem == management-graph",
          "group": "2_actions@1"
        },
        {
          "command": "codeExplorer.reindexFull",
          "when": "viewItem == root-management || viewItem == management-graph",
          "group": "2_actions@2"
        },
        {
          "command": "codeExplorer.openWorkspaceSettings",
          "when": "viewItem == root-management || viewItem == management-settings",
          "group": "2_actions@3"
        },
        {
          "command": "codeExplorer.distillIntents",
          "when": "viewItem == root-management || viewItem == management-intent || viewItem == root-domains || viewItem == domain-item || viewItem == bounded-context-item",
          "group": "3_intent@1"
        },
        {
          "command": "codeExplorer.reindexIntentsFull",
          "when": "viewItem == root-management || viewItem == management-intent",
          "group": "3_intent@2"
        },
        {
          "command": "codeExplorer.clearIntents",
          "when": "viewItem == root-management || viewItem == management-intent",
          "group": "3_intent@3"
        },
        {
          "command": "codeExplorer.restartServer",
          "when": "viewItem == root-management || viewItem == management-server",
          "group": "4_server@1"
        },
        {
          "command": "codeExplorer.updateEngine",
          "when": "viewItem == root-management || viewItem == management-server",
          "group": "4_server@2"
        },
        {
          "command": "codeExplorer.refreshTree",
          "when": "viewItem == root-management || viewItem == management-server || viewItem == management-graph || viewItem == management-intent || viewItem == management-settings || viewItem == root-gates",
          "group": "4_server@3"
        }
      ],
      "editor/title": [
        {
          "command": "codeExplorer.showGraph",
          "group": "navigation",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "explorer/context": [
        {
          "command": "codeExplorer.showGraph",
          "group": "7_modification"
        },
        {
          "command": "codeExplorer.reindex",
          "group": "7_modification"
        },
        {
          "command": "codeExplorer.excludeFromScan",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "CodeExplorer",
      "properties": {
        "codeExplorer.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the 'ce' or 'ce.exe' binary. If empty, searches the workspace and system PATH."
        },
        "codeExplorer.engineVersion": {
          "type": "string",
          "default": "",
          "description": "Target engine version or probing pattern (e.g. '1.16.*', '^1.16.0', 'latest', or exact version). If empty, automatically matches the extension's major.minor series with fallback to extension version."
        },
        "codeExplorer.serverPort": {
          "type": "number",
          "default": 0,
          "description": "Port for CodeExplorer WebSocket server. Set to 0 to use an automatically allocated ephemeral port."
        },
        "codeExplorer.idleTimeout": {
          "type": "number",
          "default": 0,
          "description": "Idle timeout in seconds before the background ce.exe server terminates when all windows are closed (0 = managed by extension transport)."
        },
        "codeExplorer.ai.provider": {
          "type": "string",
          "enum": [
            "builtin",
            "openai",
            "gguf"
          ],
          "enumDescriptions": [
            "Use built-in IDE language model (Copilot / Gemini in Antigravity) with zero download",
            "Use local or cloud OpenAI-compatible server (Ollama, LM Studio, vLLM, DeepSeek, etc.)",
            "Use locally downloaded Qwen-2.5 GGUF model via llama.cpp"
          ],
          "default": "builtin",
          "description": "AI provider used for domain discovery and architectural intent distillation."
        },
        "codeExplorer.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model identifier or family (e.g. 'copilot-gpt-4o', 'gemini-2.0-flash', 'qwen2.5-coder:7b'). Leave empty to use default."
        },
        "codeExplorer.ai.endpoint": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Endpoint URL for OpenAI-compatible provider (e.g. http://localhost:11434/v1 for Ollama, http://localhost:1234/v1 for LM Studio)."
        },
        "codeExplorer.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API Key for custom OpenAI-compatible endpoints."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs --production",
    "build:dev": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/webview/commands/CommandManager.test.ts src/webview/layout/concentricLayout.test.ts src/webview/layout/orbitConfig.test.ts src/webview/layout/domainLayouts.test.ts src/webview/layout/projectMapLayout.test.ts src/binaryManager.test.ts src/serverTransport.test.ts src/webview/utils/wheelZoom.test.ts src/webview/components/FloatingPanel.test.ts src/webview/domain/searchUtils.test.ts src/webview/domain/hiddenState.test.ts src/webview/domain/unifiedSidebar.test.ts src/webview/domain/gateState.test.ts src/webview/domain/gateEditor.test.ts src/webview/domain/entityBadges.test.ts src/webview/domain/nodeGrouping.test.ts src/webview/domain/inspectorSchema.test.ts src/webview/services/webviewTransport.test.ts src/webview/nodePresentation.test.ts --bundle --platform=node --external:vscode --outdir=dist/test --outbase=src && node dist/test/webview/commands/CommandManager.test.js && node dist/test/webview/layout/concentricLayout.test.js && node dist/test/webview/layout/orbitConfig.test.js && node dist/test/webview/layout/domainLayouts.test.js && node dist/test/webview/layout/projectMapLayout.test.js && node dist/test/binaryManager.test.js && node dist/test/serverTransport.test.js && node dist/test/webview/utils/wheelZoom.test.js && node dist/test/webview/components/FloatingPanel.test.js && node dist/test/webview/domain/searchUtils.test.js && node dist/test/webview/domain/hiddenState.test.js && node dist/test/webview/domain/unifiedSidebar.test.js && node dist/test/webview/domain/gateState.test.js && node dist/test/webview/domain/gateEditor.test.js && node dist/test/webview/domain/entityBadges.test.js && node dist/test/webview/domain/nodeGrouping.test.js && node dist/test/webview/domain/inspectorSchema.test.js && node dist/test/webview/services/webviewTransport.test.js && node dist/test/webview/nodePresentation.test.js",
    "build:binaries": "node scripts/build-extension-binaries.mjs",
    "package": "node scripts/package-extension.mjs",
    "package:all": "node scripts/package-extension.mjs --all",
    "package:universal": "node scripts/package-extension.mjs --universal",
    "publish:marketplace": "node scripts/publish-extension.mjs --marketplace",
    "publish:ovsx": "node scripts/publish-extension.mjs --ovsx",
    "publish:all": "node scripts/publish-extension.mjs"
  },
  "dependencies": {
    "@types/d3-force": "^3.0.10",
    "@xyflow/react": "^12.11.6",
    "cytoscape": "^3.30.4",
    "cytoscape-dagre": "^2.5.0",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "mermaid": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.14.4"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.19.16",
    "@types/cytoscape-dagre": "^2.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "ovsx": "^1.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
